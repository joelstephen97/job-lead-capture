{
  "manifest_version": 3,
  "name": "LeadingLeads",
  "short_name": "LeadingLeads",
  "version": "0.1.0",
  "description": "LeadingLeads: capture job-board leads (company + email) locally in your browser and move emails to Gmail BCC.",
  "permissions": ["storage", "scripting", "permissions"],
  "host_permissions": ["https://*.linkedin.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LeadingLeads",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}


